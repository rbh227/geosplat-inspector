# SplatAgent backend — model provider config (copy to backend/.env).
# Keys are read from the environment only; never commit real keys.
#
# Prefer not to touch this file? The in-app model picker (gear icon in the top
# bar) does the same thing without env editing — pick a provider, paste a key,
# Test, Save. A saved in-app choice is stored in backend/.data/settings.json
# (gitignored, owner-only permissions) and takes precedence over the env vars
# below. Override the storage location with SPLATAGENT_SETTINGS_PATH.

# ── Path 1 — Gemini (default, cloud). Zero-config polished demo. ──
MODEL_PROVIDER=gemini
GEMINI_API_KEY=...

# ── Path 2 — Any OpenAI-compatible API (cloud): OpenAI, OpenRouter, Together… ──
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=                       # leave empty for real OpenAI

# ── Path 3 — Local / self-hosted (vLLM, Ollama, LM Studio). Cheap test path. ──
# Serve a vision model locally, SSH-tunnel it to localhost:8000, then:
# MODEL_PROVIDER=openai
# MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
# OPENAI_BASE_URL=http://localhost:8001/v1   # 8001, NOT 8000 (the backend owns 8000)
# OPENAI_API_KEY=not-needed              # local servers don't authenticate
