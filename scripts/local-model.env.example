# Copy to scripts/local-model.env (gitignored) and fill in your own GPU host.
# Only VLLM_SSH_HOST is required; everything else has a sane default (see
# scripts/local-model.sh for the full list of overridable VLLM_* variables).

VLLM_SSH_HOST=you@your-gpu-box
# VLLM_GPU_ID=0
# VLLM_MODEL is the ONE model identity for the whole stack: local-model.sh
# serves it AND dev.sh derives the backend's MODEL_NAME from it, so the two
# can never disagree. Multi-GPU example (tensor parallel across two cards):
#   VLLM_GPU_ID=1,2
#   VLLM_MODEL=Qwen/Qwen3-VL-32B-Instruct-FP8
#   VLLM_SERVE_ARGS="--tensor-parallel-size 2 --gpu-memory-utilization 0.90 --max-model-len 24576 --enable-auto-tool-choice --tool-call-parser hermes"
# VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
