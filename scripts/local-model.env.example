# Copy to scripts/local-model.env (gitignored) and fill in your own GPU host.
# Only VLLM_SSH_HOST is required; everything else has a sane default (see
# scripts/local-model.sh for the full list of overridable VLLM_* variables).

VLLM_SSH_HOST=you@your-gpu-box
